# Required. Used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Required for the AI reading aids (questions, definitions, translations)
ANTHROPIC_API_KEY=

# Absolute path to the directory holding EPUB files.
# Defaults to ./books/ relative to the project root if unset.
BOOK_DIR=

# --- Optional -------------------------------------------------------------

# Days a deleted book stays in the trash (undoable) before it's removed.
# TRASH_RETENTION_DAYS=30

# Fuzzy-match cutoff (0-1) for the /books "do I own this?" lookup.
# LIBRARY_MATCH_THRESHOLD=0.6

# Behind the dashboard proxy: trust this header for the signed-in user, and
# serve under this path.
# AUTH_PROXY_HEADER=X-Forwarded-User
# APPLICATION_ROOT=/library

# Comics: where the library's CBZs live (default: instance/comics), and the
# folder whose files are imported (default: COMIC_DIR/_import).
# COMIC_DIR=/mnt/backup/comics
# COMIC_IMPORT_DIR=
# Metadata keys can be set here or in Settings (the gear).
# COMICVINE_API_KEY=
# METRON_USERNAME=
# METRON_PASSWORD=
